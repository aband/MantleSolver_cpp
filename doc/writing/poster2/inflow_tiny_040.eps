{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 270
  /ImageMatrix [54 0 0 270 0 0]
  /Width 54
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
