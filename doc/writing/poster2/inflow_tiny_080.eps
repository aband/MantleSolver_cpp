%AXGEndBitmap
GR
GR
GS
[0.48 0 0 0.48 0 0] CT
[1 0 0 1 0 0] CT
N
0 0 M
150 0 L
150 750 L
0 750 L
0 0 L
cp
clip
GS
0 0 translate
96 270 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 270
  /ImageMatrix [96 0 0 270 0 0]
  /Width 96
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
